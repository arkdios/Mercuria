{
  "_schema": "http://json-schema.org/draft-04/schema#",
  "properties": {
    "parcel": {
      "type": "object"
    },
    "client_genuine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "client_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "client_platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "client_steam_id": {
      "type": "string"
    },
    "latest_parcel_index": {
      "type": "integer",
      "minimum": -1
    }
  },
  "required": [
    "parcel",
    "client_genuine_id",
    "client_platform",
    "client_version",
    "latest_parcel_index"
  ],
  "additionalProperties": false,
  "type": "object"
}
